# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git gnupg ripgrep sqlite3 util-linux \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.6.5 --activate \
  && npm install -g @openai/codex

WORKDIR /app

FROM base AS build

RUN apt-get update \
  && apt-get install -y --no-install-recommends g++ make python3 \
  && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY implementation ./implementation

RUN pnpm install --frozen-lockfile \
  && pnpm build \
  && pnpm prune --prod

FROM base AS runtime

ENV NODE_ENV=production
ENV HOME=/data/codex-home
ENV CODEX_HOME=/data/codex-home/.codex

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/dist/src/knowledge/public-source-fetch.js ./.agents/skills/public-source-fetch/scripts/public-source-fetch.runtime.js
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml AGENTS.md ./
COPY migrations ./migrations
COPY implementation/AGENTS.md ./implementation/AGENTS.md
COPY implementation/references ./implementation/references
COPY scripts/ops ./scripts/ops

RUN cat > ./.agents/skills/public-source-fetch/scripts/fetch-public-source.ts <<'EOF'
import { parseArgs } from "node:util";

import { fetchPublicSource } from "../../../../dist/src/knowledge/public-source-fetch.js";

const { values } = parseArgs({
  args: process.argv.slice(2),
  options: {
    url: {
      type: "string"
    }
  },
  strict: true,
  allowPositionals: false
});

const rawUrl = values.url?.trim();
if (!rawUrl) {
  throw new Error("Missing required flag --url");
}

const result = await fetchPublicSource(rawUrl);
process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
EOF

RUN mkdir -p /data/vrc-ai-bot /data/codex-home/.codex /data/backups \
  && chown -R node:node /app /data/vrc-ai-bot /data/codex-home /data/backups

USER node
WORKDIR /app

CMD ["pnpm", "start"]
